{
    "name": "particle-academy/fancy-live",
    "description": "Framework-independent Pusher HTTP publishing and channel authorization, with an optional Laravel broadcaster.",
    "type": "library",
    "license": "MIT",
    "require": { "php": "^8.4" },
    "require-dev": {
        "laravel/framework": "^13.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": { "psr-4": { "FancyLive\\": "src/" } },
    "scripts": {
        "test": "pest",
        "test:core": "@php tests/core-smoke.php"
    },
    "extra": { "laravel": { "providers": ["FancyLive\\Laravel\\LiveServiceProvider"] } },
    "config": {
        "allow-plugins": { "pestphp/pest-plugin": true },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
